* {
  bg: #1e1e2eee;
  bg-alt: #313244ee;
  fg: #cdd6f4;
  fg-muted: #a6adc8;
  accent: #89b4fa;
  accent-alt: #cba6f7;
  selected: #45475a;
  urgent: #f38ba8;
  transparent: #00000000;
  font: "JetBrainsMono Nerd Font 13";
}

window {
  background-color: @bg;
  border: 1px;
  border-color: @accent;
  border-radius: 16px;
  padding: 12px;
  width: 560px;
}

mainbox {
  background-color: @transparent;
  spacing: 10px;
}

inputbar {
  background-color: @bg-alt;
  border-radius: 12px;
  padding: 10px 14px;
  children: [ prompt, entry ];
  spacing: 10px;
}

prompt {
  text-color: @accent-alt;
}

entry {
  text-color: @fg;
  placeholder: "search…";
  placeholder-color: @fg-muted;
}

listview {
  background-color: @transparent;
  lines: 10;
  spacing: 4px;
  scrollbar: false;
}

element {
  background-color: @transparent;
  text-color: @fg;
  padding: 8px 10px;
  border-radius: 12px;
}

element selected {
  background-color: @selected;
  text-color: @accent;
}

element-icon {
  size: 22px;
  padding: 0 8px 0 0;
}

element-text {
  text-color: inherit;
}

message {
  background-color: @bg-alt;
  border-radius: 12px;
  padding: 8px;
}

textbox {
  text-color: @fg;
}
