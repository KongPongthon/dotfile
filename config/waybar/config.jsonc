{
  "layer": "top", // ตำแหน่งเลเยอร์: top หรือ bottom
  "position": "top", // วางแถบไว้ด้านบนจอ
  "height": 34, // ความสูงของ bar

  // 1. กำหนดลำดับตำแหน่งโมดูล (Flexbox ซ้าย - กลาง - ขวา)
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "cpu", "memory", "tray"],

  // 2. กำหนดพฤติกรรมแต่ละ Module (เลือกใช้ตัวที่รันบน VM แล้วไม่แฮงค์)
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
  },

  "hyprland/window": {
    "max-length": 40,
    "separate-outputs": true,
  },

  "clock": {
    "format": "{:%H:%M - %d/%m/%Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
  },

  "cpu": {
    "interval": 2,
    "format": "CPU: {usage}%",
    "tooltip": false,
  },

  "memory": {
    "interval": 2,
    "format": "RAM: {percentage}%",
  },

  "pulseaudio": {
    "format": "VOL: {volume}%",
    "format-muted": "MUTED",
    "scroll-step": 5,
  },

  "tray": {
    "spacing": 10,
  },
}
