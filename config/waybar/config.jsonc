{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "custom/weather",
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "temperature",
    "backlight",
    "pulseaudio",
    "network",
    "battery",
    "mpris",
    "idle_inhibitor",
    "custom/notification",
    "tray",
    "custom/lock",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },
  "hyprland/window": {
    "max-length": 42,
    "separate-outputs": true,
    "rewrite": {
      "(.*)": "$1"
    }
  },
  "clock": {
    "interval": 30,
    "format": "{:%a %d %b %Y  %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y\n%H:%M:%S}",
    "locale": "th_TH.UTF-8"
  },
  "cpu": {
    "interval": 3,
    "format": "CPU {usage}%",
    "tooltip": true
  },
  "memory": {
    "interval": 5,
    "format": "RAM {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
  },
  "temperature": {
    "thermal-zone": 1,
    "interval": 3,
    "critical-threshold": 85,
    "format": "{temperatureC}°C",
    "format-critical": "{temperatureC}°C!",
    "tooltip": true
  },
  "backlight": {
    "format": "BRT {percent}%",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "muted",
    "on-click": "pavucontrol",
    "tooltip": true
  },
  "network": {
    "format-wifi": "{essid} {signalStrength}%",
    "format-ethernet": "eth",
    "format-disconnected": "offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% chg",
    "format-plugged": "{capacity}% ac",
    "format-icons": ["bat", "bat", "bat", "bat", "bat"],
    "tooltip-format": "{timeTo}, {capacity}%"
  },
  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} {title}",
    "max-length": 28,
    "player-icons": {
      "default": "♪",
      "spotify": "♪",
      "firefox": "♪",
      "chromium": "♪"
    },
    "status-icons": {
      "paused": "⏸",
      "playing": "♪"
    }
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "eyes",
      "deactivated": "zzz"
    },
    "tooltip-format-activated": "Idle inhibitor on",
    "tooltip-format-deactivated": "Idle inhibitor off"
  },
  "tray": {
    "spacing": 8,
    "icon-size": 16
  },
  "custom/weather": {
    "exec": "$HOME/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "interval": 1800,
    "tooltip": true
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "bell",
      "none": "bell",
      "dnd-notification": "dnd",
      "dnd-none": "dnd",
      "inhibited-notification": "bell",
      "inhibited-none": "bell",
      "dnd-inhibited-notification": "dnd",
      "dnd-inhibited-none": "dnd"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "escape": true
  },
  "custom/lock": {
    "format": "lock",
    "tooltip": "Lock",
    "on-click": "~/.config/hypr/scripts/lock.sh"
  },
  "custom/power": {
    "format": "pwr",
    "tooltip": "Logout menu",
    "on-click": "wlogout -b 2 -c 0 -r 0 -L 860 -R 860 -T 300 -B 300"
  }
}
