{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 4,
  "margin-top": 6,
  "margin-left": 12,
  "margin-right": 12,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "custom/weather",
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "temperature",
    "backlight",
    "pulseaudio",
    "network",
    "battery",
    "mpris",
    "idle_inhibitor",
    "custom/notification",
    "tray",
    "custom/lock",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },
  "hyprland/window": {
    "max-length": 42,
    "separate-outputs": true
  },
  "clock": {
    "interval": 30,
    "format": "󰥔  {:%a %d %b  %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y\n%H:%M:%S}",
    "locale": "th_TH.UTF-8"
  },
  "cpu": {
    "interval": 3,
    "format": "  {usage}%",
    "tooltip": true
  },
  "memory": {
    "interval": 5,
    "format": "  {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
  },
  "temperature": {
    "thermal-zone": 1,
    "interval": 3,
    "critical-threshold": 85,
    "format": " {temperatureC}°C",
    "format-critical": " {temperatureC}°C",
    "tooltip": true
  },
  "backlight": {
    "format": "󰃠  {percent}%",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "pulseaudio": {
    "format": "󰕾  {volume}%",
    "format-muted": "󰝟  muted",
    "on-click": "pavucontrol",
    "tooltip": true
  },
  "network": {
    "format-wifi": "󰤨  {essid} {signalStrength}%",
    "format-ethernet": "󰈀  eth",
    "format-disconnected": "󰤮  offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰁹"],
    "tooltip-format": "{timeTo}, {capacity}%"
  },
  "mpris": {
    "format": "󰝚  {title}",
    "format-paused": "󰏤  {title}",
    "max-length": 28
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip-format-activated": "Idle inhibitor on",
    "tooltip-format-deactivated": "Idle inhibitor off"
  },
  "tray": {
    "spacing": 8,
    "icon-size": 16
  },
  "custom/weather": {
    "exec": "bash ~/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "interval": 1800,
    "tooltip": true
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰪑",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "escape": true
  },
  "custom/lock": {
    "format": "",
    "tooltip": "Lock",
    "on-click": "~/.config/hypr/scripts/lock.sh"
  },
  "custom/power": {
    "format": "",
    "tooltip": "Logout menu",
    "on-click": "wlogout"
  }
}
