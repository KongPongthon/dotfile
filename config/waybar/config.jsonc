{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 0,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["backlight", "battery", "pulseaudio", "cpu", "memory", "tray"],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
  },

  "hyprland/window": {
    "max-length": 40,
    "separate-outputs": true,
  },

  "clock": {
    "format": " {:%H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["", "", "", "󰃝", "󰃞", "󰃟", "󰃠"],
    "tooltip-format": "Brightness {percent}%",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
  },

  "cpu": {
    "interval": 2,
    "format": "󰍛 {usage}%",
    "tooltip": false,
  },

  "memory": {
    "interval": 2,
    "format": "󰾆 {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""],
    },
    "scroll-step": 5,
    "on-click": "pamixer -t",
    "on-click-right": "pavucontrol",
    "tooltip-format": "{desc} {volume}%",
  },

  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}",
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8,
  },
}
