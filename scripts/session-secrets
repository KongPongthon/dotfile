#!/usr/bin/env bash
# Start gnome-keyring for this login and keep it unlocked.
# SDDM already has the user password (pam_gnome_keyring). Apps must not ask again.
set -euo pipefail

if ! command -v gnome-keyring-daemon >/dev/null 2>&1; then
    exit 0
fi

KEYRING_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/keyrings"
mkdir -p "$KEYRING_DIR"

if [[ ! -f "$KEYRING_DIR/default" ]]; then
    printf 'login\n' >"$KEYRING_DIR/default"
fi

# Empty unencrypted login keyring: unlocks with the session, no extra password dialog.
if [[ ! -f "$KEYRING_DIR/login.keyring" && ! -f "$KEYRING_DIR/user.keystore" ]]; then
    cat >"$KEYRING_DIR/login.keyring" <<'EOF'
[keyring]
display-name=login
ctime=0
mtime=0
lock-on-idle=false
lock-after=false
EOF
fi

# Idempotent: if PAM already started the daemon, this reuses it and prints env.
daemon_out="$(gnome-keyring-daemon --start --components=pkcs11,secrets,ssh 2>/dev/null || true)"
if [[ -n "$daemon_out" ]]; then
    eval "$daemon_out"
fi

import_vars=()
[[ -n "${SSH_AUTH_SOCK:-}" ]] && import_vars+=(SSH_AUTH_SOCK)
[[ -n "${GNOME_KEYRING_CONTROL:-}" ]] && import_vars+=(GNOME_KEYRING_CONTROL)
if ((${#import_vars[@]})); then
    dbus-update-activation-environment --systemd "${import_vars[@]}" >/dev/null 2>&1 || true
    systemctl --user import-environment "${import_vars[@]}" >/dev/null 2>&1 || true
fi
